# Copy into Streamlit Community Cloud under Settings, Secrets.
# Use a SEPARATE OpenRouter key with a hard credit limit set on it, never the
# main account key. When the cap is reached the app degrades to the completed
# runs instead of failing, and nothing else on the account is affected.
OPENROUTER_API_KEY = "sk-or-v1-..."

# Optional. Without these the report renders and the booking link works, but the
# two email actions report that sending is not configured rather than failing.
BREVO_API_KEY = "xkeysib-..."
BREVO_SENDER_EMAIL = "you@yourdomain.com"
BREVO_SENDER_NAME = "Your Name"
