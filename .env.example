# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required for a live run. Demo mode needs none of these.
OPENROUTER_API_KEY=

# Optional. Only needed for the email delivery leg.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Optional model overrides. Sensible defaults are set in diagnose.py.
# MODEL_EXTRACT=anthropic/claude-haiku-4.5
# MODEL_CLASSIFY=anthropic/claude-sonnet-5
# MODEL_ADVERSARY=anthropic/claude-haiku-4.5
